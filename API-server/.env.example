# Copy to .env (gitignored) in this directory — docker-compose.yml reads .env
# automatically since it lives alongside the compose file.

# Required for chat endpoints to work; passed into the api container as
# Anthropic__ApiKey (ASP.NET Core's env-var config binder maps __ to :).
ANTHROPIC_API_KEY=

# Optional: origin allowed to connect to realtime-service's Socket.IO server.
REALTIME_CORS_ORIGIN=*
